{
  "name": "semester1_aasportfolio",
  "version": "1.0.0",
  "description": "GSEA English Learning Portfolio",
  "main": "index.js",
  "scripts": {
    "build": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --minify",
    "build:dev": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css",
    "watch": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --watch",
    "dev": "npx @tailwindcss/cli -i ./src/input.css -o ./output.css --watch",
    "package:moodle": "rm -f moodle_portfolio_package.zip && zip -r moodle_portfolio_package.zip imsmanifest.xml index.html output.css"
  },
  "keywords": [
    "gsea",
    "portfolio",
    "moodle",
    "tailwindcss"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
